APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/finpilot.db
# Production: use a unique random value of at least 32 characters.
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_SIZE_MB=25
# Set to true ONLY when the API runs behind your own reverse proxy (enables X-Forwarded-For for rate limiting).
TRUST_PROXY=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# KYC uploads are encrypted at rest. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: put the NEW key first, comma-separated: KYC_ENCRYPTION_KEY=<new>,<old>  (first encrypts, all decrypt)
KYC_ENCRYPTION_KEY=
# OCR sends document images to Hugging Face only when explicitly enabled.
KYC_OCR_ENABLED=false
HF_TOKEN=
HF_OCR_MODEL=
OCR_TIMEOUT=30
# Optional: any OpenAI-compatible chat endpoint. Leave blank to use extractive answers.
# NEVER commit a real key here - put it in your untracked .env file.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
